// PusakaFC26 — Jersey Order System
//
// Note: The local dev database is SQLite (does not support Prisma enums),
// so enum-like fields are stored as String and validated at the application
// layer (see src/lib/validations.ts). The exact same schema works on
// PostgreSQL (Railway) — when migrating to Postgres you may optionally
// convert these String fields to native enums.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Gender of the registrant. Allowed values: "PRIA" | "WANITA"
model JerseyOrder {
  id         String   @id @default(cuid())
  gender     String
  fullName   String
  backName   String   @unique
  backNumber String
  size       String
  sleeve     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  paymentReceipt PaymentReceipt?
  treasurerReceipts TreasurerReceipt[]

  @@index([gender])
  @@index([backNumber])
}

enum PaymentStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model PaymentReceipt {
  id            String        @id @default(cuid())
  registrantId  String        @unique
  registrant    JerseyOrder   @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  phoneNumber   String
  phoneVerified Boolean       @default(false)
  imageUrl      String
  receiptHash   String
  status        PaymentStatus @default(PENDING_VERIFICATION)
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([receiptHash])
}

model TreasurerReceipt {
  id           String   @id @default(cuid())
  registrantId String?
  fullName     String
  phoneNumber  String
  amount       Int
  note         String?
  imageUrl     String
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  registrant JerseyOrder? @relation(fields: [registrantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([phoneNumber])
  @@index([registrantId])
}

model AdminLoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
