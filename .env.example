# Prisma database connection.
# Railway: use the Postgres service reference, for example:
# ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Required for the admin panel. Use a strong unique password in each environment.
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# Required to sign admin session cookies. Use a random value of at least 32 characters.
ADMIN_SESSION_SECRET="replace-with-a-random-session-secret"

# Optional. The host normally sets this automatically in production.
NODE_ENV="development"
