# Prisma database connection.
# Railway: use the Postgres service reference, for example:
# ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Required for the admin panel. Use a strong unique password in each environment.
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# Required to sign admin session cookies. Use a random value of at least 32 characters.
ADMIN_SESSION_SECRET="replace-with-a-random-session-secret"

# Required for protected admin actions such as export, edit, delete, and duplicate numbers.
# Keep this different from ADMIN_PASSWORD and never commit the real value.
SUPER_ADMIN_PASSWORD="replace-with-a-separate-super-admin-password"

# Struk Scanner integrations.
OCR_SERVICE_URL="https://your-ocr-service.up.railway.app"
GEMINI_API_KEY="replace-with-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="receipts"
WAHA_BASE_URL="https://your-waha-service.up.railway.app"
WAHA_API_KEY="replace-with-waha-api-key"
WAHA_SESSION="default"

# Optional. The host normally sets this automatically in production.
NODE_ENV="development"
